# --- Google Sheets (akun layanan / service account) ---
SHEET_ID=
SHEET_TAB=makanan
# Tab untuk sinkronisasi isian antar perangkat (dibuat otomatis kalau belum ada)
SHEET_DRAFT_TAB=draf
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Salin private_key dari file JSON akun layanan; ganti baris baru dengan \n dan beri tanda kutip
GOOGLE_PRIVATE_KEY=

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Model cadangan (dicoba berurutan kalau model utama sibuk/kena batas). Jangan pakai model 2.5: dijadwalkan dimatikan 16 Oktober 2026.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash,gemini-3.8-flash
AI_DAILY_LIMIT=100

# --- Keamanan aplikasi ---
# WAJIB di produksi: teks acak minimal 32 karakter (mis. hasil `openssl rand -hex 32`). Tanpa ini server menolak login.
# Mengganti AUTH_SECRET membuat semua perangkat di semua site harus login ulang.
AUTH_SECRET=
# PIN lama (satu PIN). Sejak V2.0 dipakai sebagai PIN site BCP kalau "bcp" tidak diisi di SITE_PINS.
APP_PIN=

# --- Site (V2.0) ---
# PIN per site standar, format JSON. Site tanpa PIN tidak muncul di layar login.
# Id yang dikenal: bcp, dps, kintap. Contoh: SITE_PINS={"bcp":"1234","dps":"5678","kintap":"9012"}
# Mengganti PIN satu site hanya membuat perangkat site itu login ulang.
SITE_PINS=
# Site lain (pilihan "Lainnya" di layar login), format JSON. Pengguna mengetik nama site saat login.
# laporan = isian bawaan "Kode site laporan", camp = isian bawaan "Camp" (keduanya opsional).
# Contoh: SITE_CUSTOM=[{"nama":"Site Tambang ABC","pin":"4321","laporan":"ABC","camp":"Camp Utama"}]
SITE_CUSTOM=

# --- Video TV (opsional) ---
# Biasanya kosongkan: ffmpeg diambil dari paket ffmpeg-static. Isi hanya kalau server punya ffmpeg sendiri, mis. /usr/bin/ffmpeg
# FFMPEG_PATH=

# --- Coba tanpa kredensial (data sementara di memori server, AI palsu) ---
# MOCK_BACKEND=1
