# --- Google Sheets (akun layanan / service account) ---
SHEET_ID=
SHEET_TAB=makanan
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Salin private_key dari file JSON akun layanan; ganti baris baru dengan \n dan beri tanda kutip
GOOGLE_PRIVATE_KEY=

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Model cadangan (dicoba berurutan kalau model utama sibuk/kena batas). Jangan pakai model 2.5: dijadwalkan dimatikan 16 Oktober 2026.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash,gemini-3.8-flash
AI_DAILY_LIMIT=100

# --- Keamanan aplikasi ---
APP_PIN=
AUTH_SECRET=

# --- Coba tanpa kredensial (data sementara di memori server, AI palsu) ---
# MOCK_BACKEND=1
